#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Custom mod-tap behavior matching QMK settings
        // TAPPING_TERM = 200, TAPPING_FORCE_HOLD, QUICK_TAP_TERM = 0
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Custom layer-tap behavior
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* QWERTY with Home Row Mods (ACGS)
         * Left:  A=Alt, S=Ctrl, D=GUI, F=Shift
         * Right: J=Shift, K=GUI, L=Ctrl, ;=Alt
         * G-hold activates movement/navigation layer
         * Esc-hold activates function layer
         *
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * | Tab  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  | Bksp |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |Esc/Fn| A/Alt| S/Ctl| D/GUI| F/Sft| G/Mov|                    |   H  | J/Sft| K/GUI| L/Ctl| ;/Alt|  '   |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * | Shift|   Z  |   X  |   C  |   V  |   B  |                    |   N  |   M  |   ,  |   .  |   /  |Sft/En|
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |Lower |Space |                    | Enter|Raise | Bksp |
         *                     `--------------------'                    `--------------------'
         */
        default_layer {
            bindings = <
                &kp TAB    &kp Q           &kp W           &kp E           &kp R            &kp T              &kp Y     &kp U            &kp I           &kp O           &kp P               &kp BSPC
                &lt 5 ESC  &hm LALT A      &hm LCTL S      &hm LGUI D      &hm LSFT F       &lt 4 G            &kp H     &hm RSFT J       &hm RGUI K      &hm RCTL L      &hm LALT SEMI       &kp SQT
                &kp LSHFT  &kp Z           &kp X           &kp C           &kp V            &kp B              &kp N     &kp M            &kp COMMA       &kp DOT         &kp FSLH            &mt RSFT RET
                                                           &kp LGUI        &mo 1            &kp SPACE          &kp RET   &mo 2            &kp BSPC
            >;
        };

        /* LOWER
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * |   ~  |   !  |   @  |   #  |   $  |   %  |                    |   ^  |   &  |   *  |   (  |   )  | Bksp |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * | Del  |      |      |      |      |      |                    |   |  |   _  |   +  |   {  |   }  |  |   |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |      |      |      |      |      |                    |      |ISO ~ |ISO | | Home | End  |      |
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |Lower |Space |                    | Enter|Raise | Del  |
         *                     `--------------------'                    `--------------------'
         */
        lower_layer {
            bindings = <
                &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT          &kp CARET  &kp AMPS        &kp ASTRK       &kp LPAR   &kp RPAR   &kp BSPC
                &kp DEL    &trans     &trans     &trans     &trans     &trans             &kp PIPE   &kp UNDER       &kp PLUS        &kp LBRC   &kp RBRC   &kp PIPE
                &trans     &trans     &trans     &trans     &trans     &trans             &trans     &kp NON_US_HASH &kp NON_US_BSLH &kp HOME   &kp END    &trans
                                                 &trans     &trans     &trans             &trans     &trans          &kp DEL
            >;
        };

        /* RAISE
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * |   `  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | Bksp |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * | Del  |      |      |      |      |      |                    |   \  |   -  |   =  |   [  |   ]  |  \   |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |      |      |      |      |      |                    |      |ISO # |ISO / |Pg Up |Pg Dn |      |
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |Lower |Space |                    | Enter|Raise | Bksp |
         *                     `--------------------'                    `--------------------'
         */
        raise_layer {
            bindings = <
                &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5             &kp N6     &kp N7          &kp N8          &kp N9     &kp N0     &kp BSPC
                &kp DEL    &trans     &trans     &trans     &trans     &trans             &kp BSLH   &kp MINUS       &kp EQUAL       &kp LBKT   &kp RBKT   &kp BSLH
                &trans     &trans     &trans     &trans     &trans     &trans             &trans     &kp NON_US_HASH &kp NON_US_BSLH &kp PG_UP  &kp PG_DN  &trans
                                                 &trans     &trans     &trans             &trans     &trans          &trans
            >;
        };

        /* ADJUST (Lower + Raise)
         *                      v------------------------RGB CONTROL--------------------v
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * |      | Reset|Debug | RGB  |RGBMOD| HUE+ |                    | HUE- | SAT+ | SAT- |BRGTH+|BRGTH-| Del  |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * | RGB  |      |      |      |      |      |                    |      |      |      |      |      |      |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * | BT0  | BT1  | BT2  | BT3  | BT4  |BT CLR|                    |      |      |      |      |      |      |
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |Lower |Space |                    | Enter|Raise | Bksp |
         *                     `--------------------'                    `--------------------'
         */
        adjust_layer {
            bindings = <
                &trans           &sys_reset       &bootloader      &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI    &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp DEL
                &rgb_ug RGB_TOG  &trans           &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans           &trans           &trans
                &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR         &trans           &trans           &trans           &trans           &trans           &trans
                                                                   &trans           &trans           &trans             &trans           &trans           &trans
            >;
        };

        /* MOVEMENT (G-hold Navigation Layer)
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * |      |      |      |      |      |      |                    | Esc  | PGDN | PGUP |      |      |      |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |      |      |      |      |      |                    | Left | Down |  Up  |Right |      |      |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |      |      |      |      |      |                    |      | End  | Home |      |      |      |
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |L word|Space |                    | Enter|R word| Bksp |
         *                     `--------------------'                    `--------------------'
         */
        movement_layer {
            bindings = <
                &trans  &trans  &trans  &trans      &trans  &trans             &kp ESC    &kp PG_DN  &kp PG_UP  &trans     &trans  &trans
                &trans  &trans  &trans  &trans      &trans  &trans             &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
                &trans  &trans  &trans  &trans      &trans  &trans             &trans     &kp END    &kp HOME   &trans     &trans  &trans
                                        &trans      &kp LA(LEFT)  &trans       &trans     &kp LA(RIGHT)  &trans
            >;
        };

        /* FUNCTION (Esc-hold)
         * ,-----------------------------------------.                    ,-----------------------------------------.
         * |      |  F1  |  F2  |  F3  |  F4  |  F5  |                    |  F6  |  F7  |  F8  |  F9  |  F10 |      |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |  F11 |  F12 |      |      |      |                    |      |      |      |      |      |      |
         * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
         * |      |      |      |      |      |      |                    |      |      |      |      |      |      |
         * `------+------+------+------+------+------'                    `------+------+------+------+------+------'
         *                     | GUI  |Lower |Space |                    | Enter|Raise | Bksp |
         *                     `--------------------'                    `--------------------'
         */
        function_layer {
            bindings = <
                &trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5             &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans
                &trans  &kp F11  &kp F12  &trans   &trans   &trans             &trans   &trans   &trans   &trans   &trans   &trans
                &trans  &trans   &trans   &trans   &trans   &trans             &trans   &trans   &trans   &trans   &trans   &trans
                                          &trans   &trans   &trans             &trans   &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
